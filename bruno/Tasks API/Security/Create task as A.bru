meta {
  name: Create task as A
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Tache secrete de A",
    "priority": "high"
  }
}

script:post-response {
  bru.setVar("taskIdA", res.body.id);
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
