meta {
  name: Get my tasks
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/tasks
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("is an array", function() {
    expect(res.getBody()).to.be.an("array");
  });
}
