meta {
  name: Get task by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/tasks/{{taskId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("id matches", function() {
    expect(res.getBody().id).to.equal(bru.getVar("taskId"));
  });
}
